# Environment variables (copy to `.env.local`)

# Backendless REST (server-only — copy values from learning/.env.local)
# BACKENDLESS_APP_ID=
# BACKENDLESS_API_KEY=
# BACKENDLESS_REST_URL=https://api.backendless.com/{APP_ID}/{API_KEY}

# Backendless Cloud Code (encrypt/save proxies, OTP cache, submit)
# BACKENDLESS_CODE_KEY=
# BACKENDLESS_CODE_URL=

# Public app URL (Vercel preview or production)
# NEXT_PUBLIC_APP_URL=https://bms-sis-reg.vercel.app

# Local dev runs on port 3010 (avoids collision with transcripts app on 3000)

# External write guard (default off until proven)
EXTERNAL_WRITES_ENABLED=false

# Parent OTP session (openssl rand -base64 32)
# AUTH_SECRET=
