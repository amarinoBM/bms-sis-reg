# Copy this file to .env.local.

# Start here. Demo mode works without Backendless and never runs in production.
DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3010
EXTERNAL_WRITES_ENABLED=false

# Live local development. Add these values and set DEMO_MODE=false.
AUTH_SECRET=
BACKENDLESS_REST_URL=
BACKENDLESS_CODE_URL=

# Admin access stays off unless you are testing the approved admin flow.
ADMIN_ACCESS_ENABLED=false
ADMIN_AUTH_SECRET=
ADMIN_AUDIT_TABLE=reg_admin_audit
ADMIN_EMAIL_LEAD_ID=
