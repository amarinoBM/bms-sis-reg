# Environment variables (copy to `.env.local`)

# Admin access stays off until its audit-table permissions and preview flow are verified.
ADMIN_ACCESS_ENABLED=false
ADMIN_AUTH_SECRET=
ADMIN_AUDIT_TABLE=reg_admin_audit
# Explicitly approved test/internal Close lead; never a viewed family's lead.
ADMIN_EMAIL_LEAD_ID=

# Required in production on Vercel:
# AUTH_SECRET=            (openssl rand -base64 32)
# BACKENDLESS_REST_URL=https://api.backendless.com/{APP_ID}/{API_KEY}
# BACKENDLESS_CODE_URL=https://api.backendless.com/{APP_ID}/{CODE_KEY}
# NEXT_PUBLIC_APP_URL=https://reg.brilliantmicroschools.org
# EXTERNAL_WRITES_ENABLED=true

# Local
# BACKENDLESS_REST_URL=
# BACKENDLESS_CODE_URL=
# NEXT_PUBLIC_APP_URL=http://localhost:3010
# AUTH_SECRET=

# Keep false locally unless you intend to write to Backendless
EXTERNAL_WRITES_ENABLED=false
